{
    "name": "webmunkeez/i18n-bundle",
    "type": "symfony-bundle",
    "description": "Internationalization for Symfony.",
    "keywords": [
        "symfony",
        "autowiring",
        "internationalization",
        "language"
    ],
    "homepage": "https://github.com/yannissgarra/i18n-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yannis Sgarra",
            "email": "hello@yannissgarra.com",
            "homepage": "https://yannissgarra.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/string": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/validator": "^7.4",
        "twig/twig": "^3",
        "webmunkeez/cqrs-bundle": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpunit/phpunit": "^11",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Webmunkeez\\I18nBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmunkeez\\I18nBundle\\Test\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    }
}
